# macOS Finder metadata
.DS_Store

# Original images — keep locally, except for the backdrop JPGs below
public/images/**/*.jpg
public/images/**/*.JPG
public/images/**/*.jpeg
public/images/**/*.JPEG
public/images/**/*.png
public/images/**/*.PNG
public/images/**/*.tiff
public/images/**/*.tif

# High-resolution backdrop JPGs
!public/images/backdrops/*.[jJ][pP][gG]
!public/images/backdrops/*.[jJ][pP][eE][gG]
